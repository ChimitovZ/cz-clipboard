{
  "name": "cz-clipboard",
  "productName": "CZ Clipboard",
  "version": "1.0.0",
  "description": "Менеджер буфера обмена с историей для Windows",
  "main": "electron/main.js",
  "author": "CZ",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "pinia": "^3.0.3",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  }
}
